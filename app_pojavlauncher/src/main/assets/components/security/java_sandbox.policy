// PojavLauncher JRE Sandbox Policy
// WARNING: Do NOT edit this file unless you understand Java Security Policy syntax.
// This sandbox is critical to protect against malicious Java code, especially when running mods or unknown libraries.

priority "grant";

grant {
    // Allow access to working directory and temp/user directories
    permission java.io.FilePermission "./-", "read, write, delete";
    permission java.io.FilePermission "${java.io.tmpdir}/-", "read, write, delete";
    permission java.io.FilePermission "${user.home}/-", "read, write, delete";
};

deny {
    // Deny access to sensitive/private account files
    permission java.io.FilePermission "${pojav.path.private.account}/-", "read, write, delete";
    
    // Deny global write/delete/execute access to any unspecified file
    permission java.io.FilePermission "<<ALL FILES>>", "write, delete, execute";
};
